# ==========================================================
# .gitignore - EwuarSoft (Tienda y Licores La Farra)
# Evidencia SENA: GA7-220501096-AA4-EV03
# ==========================================================

# 1. Dependencias de Node.js (Archivos pesados)
node_modules/
*/node_modules/

# 2. Variables de entorno y credenciales sensibles (CRÍTICO)
.env
.env.*
!.env.example
*.env

# 3. Archivos de registro y depuración (Logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Archivos temporales del sistema y bloqueos
*.tmp
*.temp
*.pid
*.pid.lock
*.seed

# 5. Archivos del Sistema Operativo
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~

# 6. Carpetas y configuraciones de editores de código (IDE)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Bases de datos locales temporales / respaldos
*.sqlite
*.sqlite3
*.db
*.bak
*.backup

# 8. Archivos y reportes generados de pruebas / Postman
coverage/
.nyc_output/
.postman/
postman/
test-system.js
